# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ----- Postgres (consumed by docker-compose and prisma) -----
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=cinematch
POSTGRES_DB=cinematch
POSTGRES_PORT=5432

# Connection string used by Prisma in the api and worker apps.
# Host is "postgres" when running inside docker compose, "localhost" when running on the host.
DATABASE_URL=postgresql://cinematch:cinematch@localhost:5432/cinematch

# ----- Redis -----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- API -----
API_PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ----- ML service -----
ML_PORT=8001
ML_SERVICE_URL=http://localhost:8001

# ----- External APIs -----
# Get a TMDB API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# JustWatch does not publish an official public API; placeholder for the chosen client.
JUSTWATCH_API_KEY=

# ----- Email (password reset) -----
# Grab a key at https://resend.com/api-keys — free tier is 100/day, 3000/mo.
# Leave RESEND_API_KEY empty in dev to log reset links to the API console instead.
RESEND_API_KEY=
# "From" header. Without a verified domain, Resend's sandbox sender below only
# delivers to the email of the account that owns the API key.
RESEND_FROM_EMAIL=CineMatch <onboarding@resend.dev>
# Deep link base for the reset URL. Standalone build: cinematch://reset-password.
# Expo Go test on your LAN: exp://192.168.1.79:8081/--/reset-password
APP_DEEP_LINK_BASE=cinematch://reset-password

# ----- Letterboxd scraping etiquette -----
LETTERBOXD_USER_AGENT=CineMatch/0.1 (+contact@cinematch.example)
LETTERBOXD_GLOBAL_CONCURRENCY=5

# ----- Gameplay tunables (override the defaults in apps/api/src/config/gameplay.config.ts) -----
# Uncomment to override.
# PODIUM_SIZE=3
# DISLIKE_COOLDOWN_DAYS=15
# FREE_TIER_MATCH_LIMIT=3
# FREE_TIER_PERIOD=MONTHLY
