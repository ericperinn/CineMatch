# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ----- Postgres (consumed by docker-compose and prisma) -----
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=cinematch
POSTGRES_DB=cinematch
POSTGRES_PORT=5432

# Connection string used by Prisma in the api and worker apps.
# Host is "postgres" when running inside docker compose, "localhost" when running on the host.
DATABASE_URL=postgresql://cinematch:cinematch@localhost:5432/cinematch

# ----- Redis -----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- API -----
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ----- ML service -----
ML_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# ----- External APIs -----
# Get a TMDB API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# JustWatch does not publish an official public API; placeholder for the chosen client.
JUSTWATCH_API_KEY=

# ----- Letterboxd scraping etiquette -----
LETTERBOXD_USER_AGENT=CineMatch/0.1 (+contact@cinematch.example)
LETTERBOXD_GLOBAL_CONCURRENCY=5

# ----- Gameplay tunables (override the defaults in apps/api/src/config/gameplay.config.ts) -----
# Uncomment to override.
# PODIUM_SIZE=3
# DISLIKE_COOLDOWN_DAYS=15
# FREE_TIER_MATCH_LIMIT=3
# FREE_TIER_PERIOD=MONTHLY
